---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Songtao Li | PhD Student, PolyU Department of Computing"
  canonicalPath="/"
  current="home"
>
  <main id="main" tabindex="-1">
    <div class="container container-narrow">
      <h1 class="page-title">Welcome to Songtao Li's Personal Website</h1>
      <div class="profile-intro">
        <p>
          Hello! I'm a PhD student at The Hong Kong Polytechnic University (PolyU).
        </p>
        <p>My research interests include:</p>
        <ul class="interest-list">
          <li>Large Language Models</li>
          <li>Useful and Practical Interpretability</li>
          <li>Data-Centric AI</li>
        </ul>
        <p>
          I'm passionate about solving complex problems through innovative technologies and mathematical approaches. Check out my <a href="/publications/">publications</a> to learn more about my research work.
        </p>
      </div>
      <div class="achievements">
        <h2>News</h2>
        <ul>
          <li><strong>September 2026:</strong> Joined The Hong Kong Polytechnic University (PolyU) as a PhD student</li>
        </ul>
      </div>
      <div class="honors">
        <h2>Honors & Awards</h2>
        <ul>
          <li><strong>National Scholarship</strong> (December 2023)</li>
        </ul>
      </div>
      <footer>
        <p>© 2024 Songtao Li. All rights reserved.</p>
        <div class="social-links">
          <a href="https://github.com/xiaoxiaoxiaotao" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/songtao-li-a0a757274/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </footer>
    </div>
  </main>
</BaseLayout>
