---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Songtao Li | PolyU Department of Computing"
  description="About Li Songtao, a PhD student in the Department of Computing at The Hong Kong Polytechnic University (PolyU). The name is also searched as Songtao Li."
  canonicalPath="/about/"
  current="about"
>
  <main id="main" tabindex="-1">
    <div class="container container-narrow">
      <section class="profile-section">
        <div class="profile-layout">
          <div class="profile-photo">
            <img src="/images/photo.jpg" alt="Portrait of Songtao Li" width="800" height="1157" decoding="async" />
          </div>
          <div class="profile-info">
            <h1 class="page-title">About Me</h1>
            <p>
              Hello! I'm Li Songtao, a PhD student at The Hong Kong Polytechnic University (PolyU), Department of Computing.
            </p>
            <p>
              Since starting my undergraduate studies in 2022, I have developed deep expertise in AI-related fields. I am always excited about new challenges and love to learn and grow through my work.
            </p>
          </div>
        </div>
      </section>

      <div class="resume-section">
        <div class="resume-item">
          <h2>Education</h2>
          <ol class="education-list">
            <li>
              <p class="education-when">Sep 2026 – present</p>
              <div class="education-body">
                <p class="education-degree">PhD student</p>
                <p class="education-place">Department of Computing, The Hong Kong Polytechnic University (PolyU)</p>
                <p class="education-meta">Supervised by <a href="https://ninghaohello.github.io/" target="_blank" rel="noopener noreferrer">Ninghao Liu</a></p>
              </div>
            </li>
            <li>
              <p class="education-when">Sep 2022 – Jul 2026</p>
              <div class="education-body">
                <p class="education-degree">Bachelor of Engineering</p>
                <p class="education-place">Sydney Smart Technology College, Northeastern University (China)</p>
              </div>
            </li>
          </ol>
        </div>
        <div class="resume-item">
          <h2>Interests</h2>
          <ul class="interest-list">
            <li>Chinese chess</li>
            <li>jogging</li>
            <li>traveling</li>
          </ul>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
