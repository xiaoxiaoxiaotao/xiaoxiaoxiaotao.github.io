---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { publishedPosts } from '../../lib/posts';

const posts = await publishedPosts();
---

<BaseLayout
  title="Blog | Songtao Li"
  description="Blog by Li Songtao, a PhD student in the Department of Computing at The Hong Kong Polytechnic University (PolyU)."
  canonicalPath="/blog/"
  current="blog"
>
  <main id="main" tabindex="-1">
    <div class="container container-narrow">
      <h1 class="page-title">Blog</h1>
      {
        posts.length === 0 ? (
          <div class="post-item blog-empty">
            <h2>No posts yet</h2>
            <p class="post-description">Notes will be listed here.</p>
          </div>
        ) : (
          <div class="posts-list">
            {posts.map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        )
      }
    </div>
  </main>
</BaseLayout>
