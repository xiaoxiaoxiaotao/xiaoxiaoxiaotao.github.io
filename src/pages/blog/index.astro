---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { publishedPosts } from '../../lib/posts';

const posts = await publishedPosts();

const interactivePosts = [
  {
    href: '/blog/lm-explains-lm/',
    dateIso: '2026-11-15',
    dateLabel: '15 November 2026',
    title: 'Language Models Can Automatically Explain Language Models via Heuristic Rules',
    description:
      'An LLM agent writes, tests, and refines executable predicates to directly explain native MLP neurons in Qwen3.5-0.8B-Base without sparse dictionary decomposition.',
    tags: ['Mechanistic Interpretability', 'Heuristic Rule Discovery', 'LLM Explains LLM'],
  },
];
---

<BaseLayout
  title="Blog | Songtao Li"
  description="Blog by Li Songtao, a PhD student in the Department of Computing at The Hong Kong Polytechnic University (PolyU)."
  canonicalPath="/blog/"
  current="blog"
>
  <main id="main" tabindex="-1">
    <div class="container container-narrow">
      <h1 class="page-title">Blog</h1>
      <div class="posts-list">
        {interactivePosts.map((post) => (
          <article class="post-item">
            <p class="post-meta">
              <time datetime={post.dateIso}>{post.dateLabel}</time>
            </p>
            <h2><a href={post.href}>{post.title}</a></h2>
            <p class="post-description">{post.description}</p>
            <div class="post-tags">
              {post.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </article>
        ))}
        {posts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
