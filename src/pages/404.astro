---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="" robots="noindex" current="none" jsonLd={false}>
  <main id="main" class="container not-found" tabindex="-1">
    <h1 class="page-title">404</h1>
    <p>Sorry, the page you're looking for cannot be found.</p>
    <p><a class="text-link" href="/">Go Back to Home</a></p>
  </main>
</BaseLayout>
